SUPERAI_ENVIRONMENT=development
SUPERAI_DATABASE_URL=sqlite+pysqlite:///./superai.db
SUPERAI_LOG_LEVEL=INFO
SUPERAI_DOCUMENT_STORAGE_ROOT=./data/documents
SUPERAI_MAX_UPLOAD_BYTES=20971520
SUPERAI_DOCUMENT_EXTRACTION_TIMEOUT_SECONDS=45
SUPERAI_PDF_TEXT_MIN_CHARS_PER_PAGE=24

# OIDC token verification. No application password database is used.
SUPERAI_AUTH_ISSUER=
SUPERAI_AUTH_AUDIENCE=
SUPERAI_AUTH_JWKS_URL=
SUPERAI_AUTH_ALGORITHMS=RS256
SUPERAI_AUTH_REQUIRE_EMAIL_VERIFIED=true
SUPERAI_AUTH_BOOTSTRAP_ADMIN_EMAILS=
